#!/usr/bin/env bash
# hack — the one CLI behind the hackathon kit. Hooks, skills and humans all call this.
# Needs: git, gh (authenticated), jq. Works on macOS's stock bash 3.2.
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CFG="$ROOT/.hack/lanes.json"
LOCAL="$ROOT/.hack/local.json"
STATE="$ROOT/.hack/state"
cd "$ROOT" || exit 1

# In a git worktree, local.json lives in the main checkout.
if [ ! -f "$LOCAL" ]; then
  common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
  if [ -n "$common" ] && [ -f "$(dirname "$common")/.hack/local.json" ]; then
    LOCAL="$(dirname "$common")/.hack/local.json"
  fi
fi

die()  { echo "hack: $*" >&2; exit 1; }
warn() { echo "hack: $*" >&2; }
cfg()  { jq -r "$1" "$CFG" 2>/dev/null; }

INTEG="$(cfg '.branches.integration // "dev"')"; [ -n "$INTEG" ] || INTEG=dev
DEMO="$(cfg '.branches.demo // "prod"')";        [ -n "$DEMO" ]  || DEMO=prod

my_lane() {
  if [ -n "${HACK_LANE:-}" ]; then echo "$HACK_LANE"; return; fi
  [ -f "$LOCAL" ] && jq -r '.lane // empty' "$LOCAL" 2>/dev/null
}
my_login() { [ -f "$LOCAL" ] && jq -r '.login // empty' "$LOCAL" 2>/dev/null; }
lead()     { cfg '.lead // empty'; }
lane_exists() { [ "$(jq -r --arg l "$1" '.lanes[$l] != null' "$CFG" 2>/dev/null)" = "true" ]; }
lane_paths()  { jq -r --arg l "$1" '.lanes[$l].paths // [] | join(", ")' "$CFG" 2>/dev/null; }
has_remote()  { git remote get-url origin >/dev/null 2>&1; }
current_branch() { git symbolic-ref --quiet --short HEAD 2>/dev/null; }
in_git_op() {
  local g; g="$(git rev-parse --git-dir 2>/dev/null)" || return 1
  [ -e "$g/MERGE_HEAD" ] || [ -d "$g/rebase-merge" ] || [ -d "$g/rebase-apply" ] || [ -e "$g/CHERRY_PICK_HEAD" ]
}
repo_slug() {
  mkdir -p "$STATE"
  if [ ! -s "$STATE/repo" ]; then
    gh repo view --json nameWithOwner -q .nameWithOwner > "$STATE/repo" 2>/dev/null || { rm -f "$STATE/repo"; return 1; }
  fi
  cat "$STATE/repo"
}
# throttled <name> <seconds>: true (0) when called again too soon.
throttled() {
  local f="$STATE/$1.ts" now last
  now="$(date +%s)"; last="$(cat "$f" 2>/dev/null || echo 0)"
  [ $((now - last)) -lt "$2" ] && return 0
  mkdir -p "$STATE"; echo "$now" > "$f"; return 1
}

# ───────────────────────────── lanes ─────────────────────────────

# owner_of <repo-relative path> → lane name | @lead | @additive
owner_of() {
  jq -r --arg p "$1" '
    . as $c
    | ([ $c.lanes | to_entries[] | .key as $k | .value.paths[]?
         | select(length > 0) | select(. as $pre | $p | startswith($pre))
         | {k: $k, n: length} ] | sort_by(-.n) | .[0].k) as $hit
    | if $hit then $hit
      elif ($p | startswith("docs/lanes/")) then
        ($p | split("/")[2]) as $l | if $c.lanes[$l] then $l else "@lead" end
      elif ($p | startswith("docs/")) then "@additive"
      else "@lead" end' "$CFG"
}

# check_path <rel path> <is_new 0|1> <lane> → 0 if lane may write it; else sets DENY / OWNER.
check_path() {
  DENY=""; OWNER="$(owner_of "$1")"
  [ "$OWNER" = "$3" ] && return 0
  case "$1" in .hack/local.json|.hack/state/*|.claude/settings.local.json) return 0 ;; esac
  git check-ignore -q -- "$1" 2>/dev/null && return 0
  local ld; ld="$(lead)"
  # The lead scaffolds and cleans up: it may ADD or DELETE files anywhere, but never edit another lane's existing file.
  [ "$3" = "$ld" ] && [ "$2" != 0 ] && return 0
  case "$OWNER" in
    @additive)
      [ "$2" = 1 ] && return 0
      [ "$3" = "$ld" ] && return 0
      DENY="docs/ is additive — add a NEW file, or write under docs/lanes/$3/, instead of editing an existing shared doc"; OWNER="$ld" ;;
    @lead)
      [ "$3" = "$ld" ] && return 0
      DENY="is a shared/root file owned by the lead lane '$ld'"; OWNER="$ld" ;;
    *) DENY="belongs to lane '$OWNER'" ;;
  esac
  return 1
}

# lane-check --staged | --range A...B | <files...>   [--lane X]
cmd_lane_check() {
  local mode=files range="" lane="" files=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --staged) mode=staged ;;
      --range)  mode=range; range="$2"; shift ;;
      --lane)   lane="$2"; shift ;;
      *) files+=("$1") ;;
    esac; shift
  done
  [ -n "$lane" ] || lane="$(my_lane)"
  [ -n "$lane" ] || { echo "lane-check: no lane set (run scripts/hack setup) — skipping"; return 0; }
  lane_exists "$lane" || { echo "lane-check: '$lane' is not a lane in .hack/lanes.json — skipping"; return 0; }

  local list bad=0 st p p2
  case "$mode" in
    staged) list="$(git diff --cached --name-status -M)" ;;
    range)  list="$(git diff --name-status -M "$range")" ;;
    files)  list=""; for p in ${files[@]+"${files[@]}"}; do
              if [ -e "$p" ]; then list="$list"$'M\t'"$p"$'\n'; else list="$list"$'A\t'"$p"$'\n'; fi
            done ;;
  esac
  while IFS=$'\t' read -r st p p2; do
    [ -n "$st" ] || continue
    case "$st" in
      A*) check_path "$p" 1 "$lane" || { echo "  ✗ $p — $DENY"; bad=1; } ;;
      D*) check_path "$p" 2 "$lane" || { echo "  ✗ $p — $DENY"; bad=1; } ;;
      R*|C*) check_path "$p" 0 "$lane"  || { echo "  ✗ $p — $DENY"; bad=1; }
             check_path "$p2" 1 "$lane" || { echo "  ✗ $p2 — $DENY"; bad=1; } ;;
      *)  check_path "$p" 0 "$lane" || { echo "  ✗ $p — $DENY"; bad=1; } ;;
    esac
  done <<EOF
$list
EOF
  if [ "$bad" = 1 ]; then
    echo "LANE CHECK FAILED for lane '$lane' (allowed: $(lane_paths "$lane"), docs/lanes/$lane/, new files in docs/)."
    echo "Need a change outside your lane? scripts/hack request <lane> \"what you need\""
    return 1
  fi
  return 0
}

# ───────────────────────────── sync ─────────────────────────────

# sync [--throttle N]: merge origin/dev into the current lane branch. Never leaves a half-merge behind.
cmd_sync() {
  local thr=0
  [ "${1:-}" = "--throttle" ] && thr="${2:-30}"
  has_remote || return 0
  if [ "$thr" -gt 0 ]; then throttled sync "$thr" && return 0; fi
  git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=6 fetch -q origin "$INTEG" 2>/dev/null || return 0
  local behind br
  behind="$(git rev-list --count "HEAD..origin/$INTEG" 2>/dev/null || echo 0)"
  [ "$behind" -gt 0 ] || return 0
  br="$(current_branch)"
  if in_git_op; then echo "SYNC: $INTEG has $behind new commit(s) but a merge/rebase is in progress here — finish it, then run scripts/hack sync."; return 1; fi
  case "$br" in
    lane/*|"$INTEG") ;;
    *) echo "SYNC: $INTEG has $behind new commit(s); not auto-merging because you are on '${br:-detached HEAD}', not a lane branch."; return 0 ;;
  esac
  local summary files
  summary="$(git log --format='  %h %s (%an)' "HEAD..origin/$INTEG" | head -12)"
  files="$(git diff --name-only "HEAD...origin/$INTEG" | head -25)"
  if ! git merge-tree --write-tree HEAD "origin/$INTEG" >/dev/null 2>&1; then
    echo "SYNC BLOCKED: merging $INTEG into $br would conflict. Nothing was changed."
    echo "Conflicting files:"; git merge-tree --write-tree --name-only HEAD "origin/$INTEG" 2>/dev/null | sed -n '2,/^$/p' | sed 's/^/  /' | head -20
    echo "A conflict means someone wrote outside their lane. Resolve with the human: keep the OWNING lane's version (scripts/hack status shows owners)."
    return 1
  fi
  local out
  if out="$(git merge --no-edit -q "origin/$INTEG" 2>&1)"; then
    echo "SYNC: pulled $behind new commit(s) from $INTEG into $br:"
    echo "$summary"
    [ -n "$files" ] && { echo "Files changed by teammates:"; echo "$files" | sed 's/^/  /'; }
    echo "$files" | grep -q '^docs/lanes/.*/CONTRACT.md$' && echo "NOTE: a lane CONTRACT changed — re-read it if you consume that lane."
    return 0
  fi
  echo "SYNC SKIPPED: $INTEG has $behind new commit(s) but git refused to merge (your uncommitted edits overlap incoming files). Nothing was changed."
  echo "$out" | head -8
  return 1
}

# ───────────────────────────── inbox ─────────────────────────────

# inbox [--all] [--throttle N]: issue activity addressed to my lane since the last look.
cmd_inbox() {
  local all=0 thr=0
  while [ $# -gt 0 ]; do case "$1" in --all) all=1 ;; --throttle) thr="$2"; shift ;; esac; shift; done
  command -v gh >/dev/null 2>&1 || return 0
  has_remote || return 0
  local lane me repo
  lane="$(my_lane)"; [ -n "$lane" ] || return 0
  me="$(my_login)"
  if [ "$thr" -gt 0 ]; then throttled inbox "$thr" && return 0; fi
  repo="$(repo_slug)" || return 0
  mkdir -p "$STATE"
  local since now
  since="$(cat "$STATE/inbox_since" 2>/dev/null || true)"
  # Look back 2 minutes past "now" on the next read (clock skew / API lag); ids in inbox_seen prevent repeats.
  now="$(date -u -v-120S +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '120 seconds ago' +%Y-%m-%dT%H:%M:%SZ)"

  # First incremental check with no baseline: start the clock silently. Only --all prints the ticket list,
  # so hooks never mistake a listing for new activity.
  if [ "$all" = 0 ] && [ -z "$since" ]; then echo "$now" > "$STATE/inbox_since"; return 0; fi
  if [ "$all" = 1 ]; then
    local open
    open="$(gh issue list --repo "$repo" --state open --limit 60 --json number,title,labels,assignees 2>/dev/null \
      | jq -r --arg lane "$lane" '
        map(select([.labels[].name] | (index("lane:" + $lane) != null) or (index("broadcast") != null)))
        | sort_by(.number) | .[]
        | "  #\(.number) \(.title)  [\([.labels[].name] | join(","))]\(if (.assignees | length) > 0 then "  → @" + ([.assignees[].login] | join(",@")) else "  (unclaimed)" end)"' 2>/dev/null)" || open=""
    echo "$now" > "$STATE/inbox_since"
    if [ -n "$open" ]; then
      echo "OPEN TICKETS for lane '$lane' (+ broadcasts):"; echo "$open"
      echo "Read one: gh issue view <n> --comments"
    else
      echo "No open tickets for lane '$lane'."
    fi
    return 0
  fi

  local t1="$STATE/.issues.json" t2="$STATE/.comments.json" out
  gh api "repos/$repo/issues?state=all&since=$since&per_page=100" > "$t1" 2>/dev/null || return 0
  gh api "repos/$repo/issues/comments?since=$since&per_page=100" > "$t2" 2>/dev/null || return 0
  out="$(jq -rn --slurpfile i "$t1" --slurpfile c "$t2" --arg me "$me" --arg lane "$lane" --arg since "$since" '
    def mine: ([.labels[].name] | (index("lane:" + $lane) != null) or (index("broadcast") != null))
              or (.user.login == $me) or ([.assignees[].login] | index($me) != null);
    ($i[0] | map(select(.pull_request | not)) | map(select(mine))) as $rel
    | ($rel | map({key: (.number | tostring), value: .}) | from_entries) as $by
    | ( [ $rel[] | select(.created_at > $since and .user.login != $me)
          | {k: "i\(.number)", t: "● NEW #\(.number) \(.title) [\([.labels[].name] | join(","))] — from @\(.user.login)\n\((.body // "") | .[0:700])"} ]
      + [ $c[0][] | select(.user.login != $me and .created_at > $since)
          | (.issue_url | split("/") | last) as $n | select($by[$n])
          | {k: "c\(.id)", t: "● COMMENT on #\($n) \($by[$n].title) — @\(.user.login): \(.body | .[0:700])"} ]
      + [ $rel[] | select(.closed_at != null and .closed_at > $since)
          # only closures worth interrupting for: a request I filed with another lane got resolved
          | select(.user.login == $me and ([.labels[].name] | index("lane:" + $lane) == null)) | {k: "x\(.number)-\(.closed_at)", t: "● CLOSED #\(.number) \(.title)"} ] )
    | .[] | @base64' 2>/dev/null)" || out=""
  local seen="$STATE/inbox_seen" fresh="" row k
  touch "$seen"
  for row in $out; do
    k="$(echo "$row" | base64 -d 2>/dev/null | jq -r .k)"
    grep -qxF "$k" "$seen" && continue
    echo "$k" >> "$seen"
    fresh="$fresh$(echo "$row" | base64 -d | jq -r .t)"$'\n'
  done
  out="${fresh%$'\n'}"
  echo "$now" > "$STATE/inbox_since"
  if [ -n "$out" ]; then
    echo "INBOX — new GitHub issue activity for lane '$lane':"
    echo "$out"
    echo "(Full thread: gh issue view <n> --comments · Reply: gh issue comment <n> --body \"...\")"
  fi
  return 0
}

# pulse: the heartbeat check. Prints only what changed since the last look (teammates' merges, inbox activity,
# unclaimed ready tickets, and for the lead a due demo check). Prints "PULSE: quiet" when there is nothing to do,
# so a /loop tick that finds nothing costs almost nothing. See the hack-heartbeat skill.
PULSE_DEMO_MINUTES=30
cmd_pulse() {
  mkdir -p "$STATE"
  local lane; lane="$(my_lane)"; [ -n "$lane" ] || die "no lane set — run scripts/hack setup"
  if [ "${1:-}" = "--demo-checked" ]; then
    git rev-parse -q --verify "origin/$INTEG" > "$STATE/pulse_demo_sha" 2>/dev/null || true
    date +%s > "$STATE/pulse_demo_at"; echo "Demo check recorded."; return 0
  fi
  local out="" part
  part="$(cmd_sync 2>&1 || true)";  [ -n "$part" ] && out="$out$part"$'\n\n'
  part="$(cmd_inbox 2>/dev/null || true)"; [ -n "$part" ] && out="$out$part"$'\n\n'
  part="$(cmd_queue 2>/dev/null | awk '/^READY/{p=1;print;next} /^[A-Z]/{p=0} p' || true)"
  [ -n "$part" ] && out="$out$part"$'\n\n'
  if [ "$lane" = "$(lead)" ] && [ -f "$ROOT/docs/DEMO.md" ] && has_remote; then
    local sha last_sha last_at now prod
    sha="$(git rev-parse -q --verify "origin/$INTEG" 2>/dev/null || true)"
    prod="$(git rev-parse -q --verify "origin/$DEMO" 2>/dev/null || true)"
    last_sha="$(cat "$STATE/pulse_demo_sha" 2>/dev/null || true)"
    last_at="$(cat "$STATE/pulse_demo_at" 2>/dev/null || true)"; now="$(date +%s)"
    if [ -z "$last_at" ]; then echo "$now" > "$STATE/pulse_demo_at"   # first pulse starts the clock
    elif [ -n "$sha" ] && [ "$sha" != "$last_sha" ] && [ "$sha" != "$prod" ] && [ $((now - last_at)) -ge $((PULSE_DEMO_MINUTES * 60)) ]; then
      out="${out}DEMO CHECK DUE: $INTEG has changed since the golden path was last performed ($(( (now - last_at) / 60 )) min ago). Perform docs/DEMO.md, then: scripts/hack pulse --demo-checked"$'\n\n'
    fi
  fi
  if [ -n "$out" ]; then printf '%s' "$out" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'; else echo "PULSE: quiet"; fi
}

# ───────────────────────────── hooks ─────────────────────────────

json_context() { # <event> <text>
  jq -n --arg e "$1" --arg t "$2" '{hookSpecificOutput: {hookEventName: $e, additionalContext: $t}}'
}

cmd_hook() {
  local ev="${1:-}" input lane
  input="$(cat 2>/dev/null || true)"
  lane="$(my_lane)"
  [ -e "$STATE/debug" ] && echo "$input" | jq -c --arg ev "$ev" '{ev: $ev} + (del(.tool_input.content, .tool_input.new_string, .tool_input.old_string, .tool_response))' >> "$STATE/hook-debug.jsonl" 2>/dev/null
  case "$ev" in
    session-start)
      if [ -z "$lane" ]; then
        echo "HACKATHON KIT: this workspace is not set up yet. Lane guard, auto-sync and inbox are OFF."
        echo "Tell the user to run /hack-setup (teammate) — or /hack-init then /hack-wayfinder if they are the lead starting the project."
        return 0
      fi
      echo "HACKATHON KIT — you are lane '$lane' (@$(my_login)) on branch '$(current_branch)'. Lead lane: $(lead)."
      echo "You may write only: $(lane_paths "$lane"), docs/lanes/$lane/, and NEW files under docs/."
      cmd_sync
      cmd_direction 3
      if [ "$(jq -r '.orchestrate // false' "$LOCAL" 2>/dev/null)" = "true" ]; then
        echo "ORCHESTRATOR MODE is on: you manage this lane from this one chat (see the hack-orchestrate skill). Queue:"
        cmd_queue 2>/dev/null; rm -f "$STATE/inbox_since"; cmd_inbox >/dev/null
      else
        cmd_inbox --all
      fi
      ;;
    user-prompt)
      [ -n "$lane" ] || return 0
      cmd_sync --throttle 20; cmd_inbox --throttle 20
      ;;
    post-tool)
      [ -n "$lane" ] || return 0
      [ -n "$(echo "$input" | jq -r '.agent_id // empty' 2>/dev/null)" ] && return 0
      local out; out="$(cmd_sync --throttle 90; cmd_inbox --throttle 90)"
      [ -n "$out" ] && json_context PostToolUse "$out"
      ;;
    stop)
      [ -n "$lane" ] || return 0
      [ "$(echo "$input" | jq -r '.stop_hook_active // false' 2>/dev/null)" = "true" ] && return 0
      local out; out="$(cmd_inbox --throttle 45)"
      if [ -z "$out" ] && [ "$(jq -r '.orchestrate // false' "$LOCAL" 2>/dev/null)" = "true" ] && ! throttled queue 60; then
        local q; q="$(cmd_queue 2>/dev/null)"
        if echo "$q" | grep -q '^READY'; then
          jq -n --arg r "Orchestrator: unclaimed ready-for-agent tickets remain in your lane. Dispatch lane-worker subagents for them (at most 3 running at once), or tell the user in one line why you are not. Queue:
$q" '{decision: "block", reason: $r}'
          return 0
        fi
      fi
      if [ -n "$out" ]; then
        jq -n --arg r "Before you stop: teammates posted on your lane's issues. Read them and either act (if it is small and in your lane) or tell the user what was asked.
$out" '{decision: "block", reason: $r}'
      fi
      ;;
    lane-guard)
      [ -n "$lane" ] || return 0
      local fp rel
      fp="$(echo "$input" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' 2>/dev/null)"
      [ -n "$fp" ] || return 0
      local d top
      d="$(dirname "$fp")"; while [ ! -d "$d" ] && [ "$d" != "/" ]; do d="$(dirname "$d")"; done
      top="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)" || return 0
      [ "$(git -C "$top" rev-parse --git-common-dir 2>/dev/null | xargs -I{} sh -c 'cd "$1" && cd "{}" && pwd -P' _ "$top")" = "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)" ] || return 0
      case "$fp" in "$top"/*) rel="${fp#"$top"/}" ;; *) return 0 ;; esac
      local isnew=1; [ -e "$fp" ] && isnew=0
      check_path "$rel" "$isnew" "$lane" && return 0
      jq -n --arg r "LANE GUARD: '$rel' $DENY. You are lane '$lane' and may write only: $(lane_paths "$lane"), docs/lanes/$lane/, and new files under docs/. Do NOT work around this with Bash. If you need this change: scripts/hack request $OWNER \"<what you need and why>\" — then keep going by stubbing against docs/lanes/$OWNER/CONTRACT.md inside your own lane." \
        '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
      ;;
    git-guard)
      local c; c="$(echo "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)"
      [ -n "$c" ] || return 0
      local why="" E='([^A-Za-z0-9_./-]|$)' worker
      worker="$(echo "$input" | jq -r '.agent_id // empty' 2>/dev/null)"
      if [ -n "$worker" ] && echo "$c" | grep -Eq "git( [^;&|]*)? push$E|hack +(ship|promote|collect|init|decide)$E|gh +pr +(create|merge)$E"; then
        why="background workers only commit to their own worktree branch — the orchestrator merges, runs and ships. Finish your commit and report back"
      elif echo "$c" | grep -Eq "git( [^;&|]*)? push( [^;&|]*)? (--force|-f|--force-with-lease)$E"; then why="force-push is never allowed"
      elif echo "$c" | grep -Eq "git( [^;&|]*)? push [^;&|]*(:| |/)($DEMO|$INTEG)$E"; then why="never push to '$DEMO' or '$INTEG' directly — ship with: scripts/hack ship \"message\""
      elif echo "$c" | grep -Eq 'git +reset +--hard|git +clean +-[a-z]*f|git +checkout +(-- +)?\.( |$)|git +restore +\.( |$)|git +branch +-D|git +stash +(drop|clear)'; then why="destructive git command — it can wipe a teammate's merged work or your uncommitted work"
      elif echo "$c" | grep -Eq 'git +rebase'; then why="no rebasing during the hackathon — lane branches merge, never rebase"
      elif echo "$c" | grep -Eq -- '--no-verify'; then why="--no-verify skips the lane check"
      elif echo "$c" | grep -Eq 'gh +repo +(delete|rename|archive)'; then why="repo-level change"
      fi
      if [ -n "$why" ]; then
        jq -n --arg r "GIT GUARD: blocked — $why. Use scripts/hack sync / ship instead, or ask the human." \
          '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
        return 0
      fi
      if echo "$c" | grep -Eq "hack +decide$E"; then
        jq -n --arg r "Broadcast a direction change to the whole team. Only after the user has signed off on this exact wording." \
          '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
      elif echo "$c" | grep -Eq 'hack +promote'; then
        jq -n --arg r "Promote $INTEG → $DEMO (the demo branch). Only do this if the golden path was just run end-to-end." \
          '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
      fi
      ;;
    *) die "unknown hook '$ev'" ;;
  esac
  return 0
}

# ───────────────────────────── setup ─────────────────────────────

cmd_setup() {
  local want="${1:-}" ok=1
  echo "── Hackathon workspace setup ──"
  for t in git gh jq; do
    command -v "$t" >/dev/null 2>&1 && echo "  ✓ $t" || { echo "  ✗ $t missing — install it (macOS: brew install $t)"; ok=0; }
  done
  [ "$ok" = 1 ] || die "install the missing tools, then re-run."
  gh auth status >/dev/null 2>&1 || die "GitHub CLI is not logged in — run: gh auth login"
  local login; login="$(gh api user --jq .login 2>/dev/null)" || die "could not read your GitHub login"
  echo "  ✓ GitHub login: @$login"
  if command -v xcodebuild >/dev/null 2>&1; then echo "  ✓ Xcode: $(xcodebuild -version 2>/dev/null | head -1)"
  else echo "  – No Xcode: you can build & ship, but can't run an iOS app locally. Ask a Mac teammate to verify (scripts/hack request)."; fi

  local lane="$want"
  [ -n "$lane" ] || lane="$(jq -r --arg u "$login" '.lanes | to_entries[] | select((.value.owner // "") | ascii_downcase == ($u | ascii_downcase)) | .key' "$CFG" | head -1)"
  if [ -z "$lane" ]; then
    echo; echo "Your login isn't assigned a lane yet. Lanes:"
    jq -r '.lanes | to_entries[] | "  \(.key)  owner=@\(.value.owner // "?" | if . == "" then "unassigned" else . end)  — \(.value.mission // "")"' "$CFG"
    die "re-run with your lane:  scripts/hack setup <lane>"
  fi
  lane_exists "$lane" || die "'$lane' is not a lane in .hack/lanes.json"

  mkdir -p "$STATE"
  jq -n --arg lane "$lane" --arg login "$login" '{lane: $lane, login: $login, orchestrate: true}' > "$ROOT/.hack/local.json"
  LOCAL="$ROOT/.hack/local.json"
  git config core.hooksPath .githooks
  git config pull.rebase false
  git config merge.conflictStyle zdiff3 2>/dev/null || true
  chmod +x "$ROOT/scripts/hack" "$ROOT"/.githooks/* 2>/dev/null || true

  local br="lane/$lane"
  if has_remote; then
    git fetch -q origin 2>/dev/null || warn "fetch failed (offline?)"
    if [ "$(current_branch)" != "$br" ]; then
      if git show-ref --verify --quiet "refs/heads/$br"; then git checkout -q "$br"
      elif git show-ref --verify --quiet "refs/remotes/origin/$br"; then git checkout -q -b "$br" --track "origin/$br"
      else git checkout -q -b "$br" "origin/$INTEG" 2>/dev/null || git checkout -q -b "$br"; fi
    fi
    rm -f "$STATE/sync.ts"; cmd_sync || true
  else
    [ "$(current_branch)" = "$br" ] || git checkout -q -b "$br" 2>/dev/null || git checkout -q "$br"
    warn "no 'origin' remote yet — the lead needs to run: scripts/hack init <org/repo>"
  fi
  mkdir -p "$ROOT/docs/lanes/$lane"
  echo
  echo "✓ You are lane '$lane' on branch '$br'."
  echo "  You own: $(lane_paths "$lane"), docs/lanes/$lane/"
  echo "  Loop:  scripts/hack run  →  scripts/hack ship \"what changed\""
  echo
  rm -f "$STATE/inbox_since"; cmd_inbox --all
}

cmd_status() {
  local lane; lane="$(my_lane)"
  echo "You: lane '${lane:-NOT SET UP}' (@$(my_login)) on '$(current_branch)'   lead lane: $(lead)"
  if has_remote; then
    git fetch -q origin 2>/dev/null || true
    echo "vs $INTEG: $(git rev-list --count "origin/$INTEG..HEAD" 2>/dev/null || echo ?) ahead, $(git rev-list --count "HEAD..origin/$INTEG" 2>/dev/null || echo ?) behind   |   $DEMO is $(git rev-list --count "origin/$DEMO..origin/$INTEG" 2>/dev/null || echo ?) commit(s) behind $INTEG"
  fi
  echo "Lanes:"
  jq -r '.lanes | to_entries[] | "  \(.key)  @\(.value.owner // "" | if . == "" then "unassigned" else . end)  [\(.value.paths | join(", "))]  \(.value.mission // "")"' "$CFG"
  if has_remote && command -v gh >/dev/null 2>&1; then
    echo "Open tickets per lane:"
    gh issue list --state open --limit 200 --json labels 2>/dev/null \
      | jq -r '[.[].labels[].name | select(startswith("lane:"))] | group_by(.) | map("  \(.[0]): \(length)") | .[]' 2>/dev/null
  fi
}

# ───────────────────────────── orchestration ─────────────────────────────

# queue: my lane's open tickets, grouped by what should happen to them.
cmd_queue() {
  local lane repo; lane="$(my_lane)"; [ -n "$lane" ] || die "no lane set"
  repo="$(repo_slug)" || die "no GitHub repo"
  gh issue list --repo "$repo" --state open --limit 100 --label "lane:$lane" --json number,title,labels,assignees 2>/dev/null | jq -r '
    def line: "  #\(.number) \(.title)  [\([.labels[].name | select(startswith("P"))] | join(","))]\(if (.assignees|length) > 0 then "  → @" + ([.assignees[].login] | join(",@")) else "" end)";
    def has($l): [.labels[].name] | index($l) != null;
    map(select(has("spec")|not))
    | sort_by(([.labels[].name | select(startswith("P"))] | sort | .[0]) // "P9", .number) as $all
    | ($all | map(select((.assignees|length) == 0 and has("ready-for-agent") and (has("needs-human")|not)))) as $ready
    | ($all | map(select(has("needs-human")))) as $human
    | ($all | map(select((.assignees|length) > 0 and (has("needs-human")|not)))) as $wip
    | ($all | map(select((.assignees|length) == 0 and (has("ready-for-agent")|not) and (has("needs-human")|not)))) as $raw
    | (if ($ready|length) > 0 then "READY for a worker (\($ready|length)):", ($ready[] | line) else empty end),
      (if ($wip|length) > 0 then "IN PROGRESS (\($wip|length)):", ($wip[] | line) else empty end),
      (if ($human|length) > 0 then "NEEDS YOU (\($human|length)):", ($human[] | line) else empty end),
      (if ($raw|length) > 0 then "UNSORTED — label ready-for-agent or needs-human (\($raw|length)):", ($raw[] | line) else empty end),
      (if ($all|length) == 0 then "Queue empty." else empty end)'
}

cmd_orchestrate() {
  [ -f "$LOCAL" ] || die "run scripts/hack setup first"
  case "${1:-}" in
    on)  jq '.orchestrate = true'  "$LOCAL" > "$LOCAL.tmp" && mv "$LOCAL.tmp" "$LOCAL"; echo "Orchestration ON: this chat keeps dispatching workers while ready-for-agent tickets remain." ;;
    off) jq '.orchestrate = false' "$LOCAL" > "$LOCAL.tmp" && mv "$LOCAL.tmp" "$LOCAL"; echo "Orchestration OFF: workers are dispatched only when you ask." ;;
    *)   echo "orchestrate: $(jq -r '.orchestrate // false' "$LOCAL")   (scripts/hack orchestrate on|off)" ;;
  esac
}

# collect <worker-branch>: merge a finished worker's branch into the lane branch and remove its worktree.
cmd_collect() {
  local wb="${1:-}" br; br="$(current_branch)"
  [ -n "$wb" ] || die "usage: scripts/hack collect <worker-branch>"
  git show-ref --verify --quiet "refs/heads/$wb" || die "no branch '$wb'"
  case "$br" in lane/*) ;; *) die "run this from your lane branch (you are on '$br')" ;; esac
  in_git_op && die "a merge is in progress — finish it first"
  local n; n="$(git rev-list --count "HEAD..$wb")"
  if [ "$n" -gt 0 ]; then
    cmd_lane_check --range "HEAD...$wb" || die "worker branch '$wb' has out-of-lane changes — not merged."
    if ! git merge-tree --write-tree HEAD "$wb" >/dev/null 2>&1; then
      echo "COLLECT BLOCKED: '$wb' conflicts with $br (two workers touched the same file). Nothing was changed."
      git merge-tree --write-tree --name-only HEAD "$wb" 2>/dev/null | sed -n '2,/^$/p' | sed 's/^/  /' | head -20
      echo "Send the later worker back to redo its change on top of the current lane branch, or resolve it with the user."
      return 1
    fi
    git merge --no-edit -q "$wb" || die "merge refused (uncommitted edits overlap) — commit or ship first, then collect again"
    echo "✓ Collected $n commit(s) from $wb into $br:"; git log --format='  %h %s' "ORIG_HEAD..HEAD" --no-merges | head -10
  else
    echo "Nothing to collect from $wb (no new commits)."
  fi
  local wt; wt="$(git worktree list --porcelain | awk -v b="refs/heads/$wb" '/^worktree /{p=substr($0,10)} $0=="branch "b{print p}')"
  [ -n "$wt" ] && git worktree remove --force "$wt" 2>/dev/null
  git branch -q -D "$wb" 2>/dev/null || true
  echo "Next: scripts/hack run, check the ticket's Done-when list, then scripts/hack ship \"...\" --closes <n>"
}

# ───────────────────────────── ship / request / promote ─────────────────────────────

# ship ["message"] [--closes N] [--no-check]
cmd_ship() {
  local msg="" closes="" nocheck=0
  while [ $# -gt 0 ]; do
    case "$1" in --closes) closes="$2"; shift ;; --no-check) nocheck=1 ;; *) msg="$1" ;; esac; shift
  done
  local lane br; lane="$(my_lane)"; br="$(current_branch)"
  [ -n "$lane" ] || die "no lane set — run scripts/hack setup"
  [ "$br" = "lane/$lane" ] || die "you are on '$br', expected 'lane/$lane' — run scripts/hack setup"
  has_remote || die "no origin remote"
  in_git_op && die "a merge is in progress — finish it first"

  git add -A
  if ! cmd_lane_check --staged; then git reset -q; die "nothing shipped. Revert or move the out-of-lane changes above, then ship again."; fi
  # A broken kit file would switch off every teammate's hooks on their next sync: never ship one.
  local kf
  for kf in $(git diff --cached --name-only | grep -E '^(scripts/hack|\.githooks/.*|\.hack/lanes\.json|\.claude/settings\.json)$'); do
    [ -f "$kf" ] || continue
    case "$kf" in
      *.json) jq empty "$kf" 2>/dev/null || { git reset -q; die "$kf is not valid JSON — nothing shipped. Fix it first."; } ;;
      *) bash -n "$kf" 2>/dev/null || { git reset -q; die "$kf has a shell syntax error — nothing shipped. Fix it first: bash -n $kf"; } ;;
    esac
  done
  if ! git diff --cached --quiet; then
    git commit -q -m "${msg:-$lane: checkpoint}${closes:+ (#$closes)}" || die "commit failed"
  fi
  rm -f "$STATE/sync.ts"; cmd_sync || die "sync failed — see above. Nothing was pushed."
  local check; check="$(cfg '.run.check // empty')"
  if [ -n "$check" ] && [ "$nocheck" = 0 ]; then
    echo "check: $check"
    ( eval "$check" ) || die "check failed — fix it or (only if you are sure dev won't break) ship with --no-check"
  elif [ "$nocheck" = 0 ] && has_xcode_project \
       && git diff --name-only "origin/$INTEG...HEAD" 2>/dev/null | grep -Eqv '(\.md$|^docs/|^\.claude/|^stacks/|^\.github/|^\.githooks/|^scripts/)'; then
    # iOS default: never merge something that doesn't compile. Skipped for docs-only ships and on machines without Xcode.
    ( cmd_build ) || die "the app does not build with your changes plus the latest $INTEG — nothing was pushed. If the error is in another lane's file, that lane broke $INTEG: scripts/hack request <lane> \"build broken: <error>\"."
  fi
  if [ "$(git rev-list --count "origin/$INTEG..HEAD")" = 0 ]; then echo "Nothing to ship — $br has no commits that $INTEG lacks."; return 0; fi
  git push -q -u origin "$br" || die "push failed"

  local title pr body
  title="[$lane] ${msg:-$(git log -1 --format=%s)}"
  body="Lane: \`$lane\` · auto-shipped by \`scripts/hack ship\`.${closes:+

Closes #$closes}"
  local verb="opened"
  pr="$(gh pr list --head "$br" --base "$INTEG" --state open --json number -q '.[0].number' 2>/dev/null)"
  [ -n "$pr" ] && verb="updated (it was still open, so this ship rides along with the previous one)"
  if [ -z "$pr" ]; then
    gh pr create --base "$INTEG" --head "$br" --title "$title" --body "$body" >/dev/null || die "could not open PR"
    pr="$(gh pr list --head "$br" --base "$INTEG" --state open --json number -q '.[0].number')"
  elif [ -n "$closes" ]; then
    gh pr edit "$pr" --body "$(gh pr view "$pr" --json body -q .body)

Closes #$closes" >/dev/null 2>&1 || true
  fi
  if gh pr merge "$pr" --merge --auto >/dev/null 2>&1; then
    local st; st="$(gh pr view "$pr" --json state -q .state 2>/dev/null)"
    if [ "$st" = "MERGED" ]; then echo "✓ Shipped: PR #$pr merged into $INTEG."
    else echo "✓ PR #$pr $verb; it auto-merges into $INTEG as soon as the lane-check passes (~30s)."; fi
  elif gh pr merge "$pr" --merge >/dev/null 2>&1; then
    echo "✓ Shipped: PR #$pr merged into $INTEG."
  else
    echo "⚠ PR #$pr is open but did not merge. Look: gh pr view $pr --web   (checks: gh pr checks $pr)"
    return 1
  fi
  git fetch -q origin "$INTEG" 2>/dev/null || true
  echo "Teammates' agents pull this automatically on their next prompt."
}

# request <lane> "title" ["details"]
cmd_request() {
  local to="${1:-}" title="${2:-}" details="${3:-}"
  [ -n "$to" ] && [ -n "$title" ] || die 'usage: scripts/hack request <lane> "title" ["details"]'
  lane_exists "$to" || die "'$to' is not a lane (see scripts/hack status)"
  local lane owner; lane="$(my_lane)"; owner="$(jq -r --arg l "$to" '.lanes[$l].owner // ""' "$CFG")"
  gh issue create --title "[$to] $title" --label "lane:$to" --label request \
    --body "**From lane \`${lane:-?}\`** → **lane \`$to\`**${owner:+ (@$owner)}

$details

_Reply on this issue. The requester is stubbing against your CONTRACT meanwhile, so answer with the real shape when you can._"
}

# The one pinned issue every direction change is posted on (label: direction + broadcast). Prints its number.
direction_issue() { # [create]
  local n; n="$(cat "$STATE/direction_issue" 2>/dev/null || true)"
  if [ -z "$n" ]; then
    n="$(gh issue list --label direction --state open --limit 1 --json number -q '.[0].number' 2>/dev/null || true)"
    if [ -z "$n" ] && [ "${1:-}" = "create" ]; then
      gh label create direction --color 0052cc --description "Direction changes: every agent reads these" --force >/dev/null 2>&1 || true
      gh label create broadcast --color d93f0b --description "Everyone's agent reads this" --force >/dev/null 2>&1 || true
      n="$(gh issue create --title "Direction: every change of plan is posted here" --label direction --label broadcast \
        --body "Each comment is one decision that changes what we are building. Newest wins. Post with \`scripts/hack decide\`, never by hand. The same text is kept in \`docs/decisions/\`." 2>/dev/null | grep -Eo '[0-9]+$' || true)"
      [ -n "$n" ] && gh issue pin "$n" >/dev/null 2>&1 || true
    fi
    [ -n "$n" ] && { mkdir -p "$STATE"; echo "$n" > "$STATE/direction_issue"; }
  fi
  [ -n "$n" ] && echo "$n"
}

# decide "title" "Before/Now/Why…" [--affects lane,lane]: record a direction change and push it to every agent.
cmd_decide() {
  local title="" details="" affects="all lanes"
  while [ $# -gt 0 ]; do
    case "$1" in --affects) affects="${2:-}"; shift ;; *) if [ -z "$title" ]; then title="$1"; elif [ -z "$details" ]; then details="$1"; fi ;; esac; shift
  done
  [ -n "$title" ] && [ -n "$details" ] || die 'usage: scripts/hack decide "what changed, in one line" "Before: … / Now: … / Why: … / Judge: …" [--affects lane,lane]'
  local lane me slug f body n
  lane="$(my_lane)"; me="$(my_login)"
  slug="$(printf '%s' "$title" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//' | cut -c1-48)"
  f="docs/decisions/$(date '+%Y%m%d-%H%M%S')-$slug.md"
  body="## DIRECTION CHANGE: $title

**By** lane \`${lane:-?}\`${me:+ (@$me)} · $(date '+%Y-%m-%d %H:%M') · **Affects:** $affects

$details"
  mkdir -p docs/decisions; printf '%s\n' "$body" > "$f"
  if ! in_git_op; then git add "$f" && git commit -q -m "Direction: $title" -- "$f" || warn "could not commit $f — it will go with your next ship"; fi
  echo "✓ Recorded in $f (it reaches dev with your next scripts/hack ship)."
  if command -v gh >/dev/null 2>&1 && has_remote && n="$(direction_issue create)" && [ -n "$n" ]; then
    if gh issue comment "$n" --body "$body" >/dev/null 2>&1; then
      echo "✓ Broadcast on #$n: every teammate's agent gets it on their next prompt."
    else warn "could not post on #$n — teammates will only see it once the file ships"; fi
  else
    warn "no GitHub remote — teammates will only see it once the file ships"
  fi
  echo "Now check your own lane: open tickets and running workers that this makes stale."
}

# direction [n]: the latest n decisions (default 3), newest first. From the issue when reachable, else from docs/decisions/.
cmd_direction() {
  local k="${1:-3}" n out=""
  if command -v gh >/dev/null 2>&1 && has_remote && n="$(direction_issue)" && [ -n "$n" ]; then
    out="$(gh issue view "$n" --json comments 2>/dev/null | jq -r --argjson k "$k" '
      [.comments[] | select(.body | startswith("## DIRECTION CHANGE:"))] | reverse | .[0:$k][] | (.body | .[0:600]) + "\n"' 2>/dev/null)" || out=""
  fi
  if [ -z "$out" ] && [ -d docs/decisions ]; then
    local f; for f in $(ls -1 docs/decisions/*.md 2>/dev/null | sort -r | head -n "$k"); do out="$out$(head -c 600 "$f")"$'\n\n'; done
  fi
  [ -n "$out" ] || return 0
  echo "DIRECTION — latest decisions, newest first. They override older tickets, CONTRACTs and docs:"
  echo "$out"
}

# feedback "title" ["details"]: log a problem with the KIT itself (not the app) on the kit repo, for after the hackathon.
cmd_feedback() {
  local title="${1:-}" details="${2:-}"
  [ -n "$title" ] || die 'usage: scripts/hack feedback "what went wrong or could be better" ["details: what you ran, what happened, what you expected"]'
  local kit lane src notes body n
  kit="$(cfg '.kit // empty')"; lane="$(my_lane)"; src="$(repo_slug 2>/dev/null)"
  body="**From** \`${src:-local repo}\` · lane \`${lane:-?}\` · $(date '+%Y-%m-%d %H:%M')

${details:-_(no details)_}"
  if [ -n "$kit" ] && command -v gh >/dev/null 2>&1; then
    # Match by title across all open issues: people without write access can't apply the label, so theirs carry a title prefix.
    n="$(gh issue list -R "$kit" --state open --limit 300 --json number,title 2>/dev/null \
        | jq -r --arg t "$title" '[.[] | select((.title | ascii_downcase | ltrimstr("[kit-feedback] ")) == ($t | ascii_downcase))] | sort_by(.number)[0].number // empty')"
    if [ -n "$n" ]; then
      gh issue comment "$n" -R "$kit" --body "Hit again. $body" >/dev/null 2>&1 && { echo "✓ Already logged as $kit#$n — added this occurrence. Carry on."; return 0; }
    else
      gh label create kit-feedback -R "$kit" --color 5319e7 --description "Kit problem or improvement, logged during a hackathon" --force >/dev/null 2>&1 || true
      if gh issue create -R "$kit" --title "$title" --label kit-feedback --body "$body" >/dev/null 2>&1 \
         || gh issue create -R "$kit" --title "[kit-feedback] $title" --body "$body" >/dev/null 2>&1; then
        echo "✓ Logged on $kit. Don't fix the kit now — work around it and carry on."; return 0
      fi
    fi
  fi
  # No kit repo configured, or no access to it: keep the note in the lane so /hack-retro can file it later.
  notes="docs/lanes/${lane:-unknown}/KIT-NOTES.md"; mkdir -p "$(dirname "$notes")"
  printf -- '- **%s** (%s) %s\n' "$title" "$(date '+%m-%d %H:%M')" "$(printf '%s' "$details" | tr '\n' ' ')" >> "$notes"
  echo "✓ Noted in $notes (couldn't reach the kit repo${kit:+ $kit}). /hack-retro files these later."
}

cmd_labels() {
  command -v gh >/dev/null 2>&1 || die "gh missing"
  local l
  for l in $(jq -r '.lanes | keys[]' "$CFG"); do gh label create "lane:$l" --color 1d76db --description "Ticket owned by lane $l" --force >/dev/null && echo "  label lane:$l"; done
  gh label create broadcast --color d93f0b --description "Everyone's agent reads this" --force >/dev/null
  gh label create request   --color fbca04 --description "Cross-lane request" --force >/dev/null
  gh label create ready-for-agent --color 0e8a16 --description "Fully specified: a background worker can build it unattended" --force >/dev/null
  gh label create needs-human --color d93f0b --description "Needs a person: a decision, an account, a device, taste" --force >/dev/null
  gh label create direction --color 0052cc --description "Direction changes: every agent reads these" --force >/dev/null
  gh label create hack:map  --color 5319e7 --description "The wayfinder map" --force >/dev/null
  gh label create spec      --color 5319e7 --description "A lane's design, written down before it is split into tickets" --force >/dev/null
  gh label create P0-golden-path --color b60205 --description "On the demo's golden path" --force >/dev/null
  gh label create P1-real   --color e99695 --description "Holds up when a judge goes off script" --force >/dev/null
  gh label create P2-polish --color c5def5 --description "Polish on the showcase features" --force >/dev/null
  echo "  labels: ready-for-agent, needs-human, broadcast, request, hack:map, spec, P0-golden-path, P1-real, P2-polish"
}

# stack [ios|other]: which kind of app this is. Decides which guide in stacks/ the agents follow.
cmd_stack() {
  local s="${1:-}"
  if [ -z "$s" ]; then local cur; cur="$(cfg '.stack // empty')"
    if [ -n "$cur" ]; then echo "Stack: $cur · guide: stacks/$cur/README.md"; else echo "Stack: not chosen yet. Set it: scripts/hack stack ios|other"; fi
    return 0; fi
  case "$s" in ios|other) ;; *) die "stack must be 'ios' or 'other'" ;; esac
  local tmp; tmp="$(mktemp)"
  jq --arg s "$s" '.stack = $s' "$CFG" > "$tmp" && mv "$tmp" "$CFG" || die "could not rewrite $CFG"
  echo "✓ Stack: $s. Follow stacks/$s/README.md to set the project up."
}

# team [n]: how many people (2–6) = how many lanes. Rebuilds the placeholder lanes; refuses once lanes are named.
cmd_team() {
  local n="${1:-}"
  if [ -z "$n" ]; then
    echo "Team size: $(cfg '.team // (.lanes | length)') · lanes: $(jq -r '.lanes | keys | join(", ")' "$CFG")"; return 0
  fi
  case "$n" in 2|3|4|5|6) ;; *) die "team size must be between 2 and 6" ;; esac
  if [ "$(jq -r '[.lanes | to_entries[] | select((.key | test("^lane-[0-9]+$") | not) or ((.value.owner // "") != ""))] | length' "$CFG")" != "0" ]; then
    die "lanes are already named or owned. Changing the team size now means re-cutting the lanes: use /hack-wayfinder (Re-charting), then set \"team\" in .hack/lanes.json by hand."
  fi
  local tmp; tmp="$(mktemp)"
  jq --argjson n "$n" '.team = $n | .lead = "lane-1"
    | .lanes = ([range(1; $n + 1) | {key: "lane-\(.)", value: {owner: "", mission: (if . == 1 then "placeholder — /hack-wayfinder renames this" else "placeholder" end), paths: ["lanes/lane-\(.)/"]}}] | from_entries)' \
    "$CFG" > "$tmp" && mv "$tmp" "$CFG" || die "could not rewrite $CFG"
  echo "✓ Team of $n: $(jq -r '.lanes | keys | join(", ")' "$CFG"). /hack-wayfinder turns these into $n real lanes."
}

# init <org/repo> [--public]  — lead, once.
cmd_init() {
  local slug="${1:-}" vis="--private"
  [ "${2:-}" = "--public" ] && vis="--public"
  [ -n "$slug" ] || die "usage: scripts/hack init <org/repo> [--public]"
  gh auth status >/dev/null 2>&1 || die "run: gh auth login"
  git rev-parse --git-dir >/dev/null 2>&1 || git init -q -b "$INTEG"
  git config core.hooksPath .githooks
  chmod +x scripts/hack .githooks/* 2>/dev/null || true
  [ "$(current_branch)" = "$INTEG" ] || git checkout -q -B "$INTEG"
  git add -A
  git diff --cached --quiet || HACK_LANE="" git commit -q -m "Hackathon kit" || die "commit failed"
  if ! has_remote; then
    gh repo create "$slug" $vis --source . --remote origin --push || die "repo create failed"
  else
    git push -q -u origin "$INTEG" || die "push failed"
  fi
  HACK_PROMOTE=1 git push -q origin "$INTEG:$DEMO" 2>/dev/null || warn "could not create the $DEMO branch"
  gh repo edit "$slug" --default-branch "$INTEG" --enable-auto-merge --enable-merge-commit --delete-branch-on-merge=false >/dev/null 2>&1 \
    || warn "could not set repo options (default branch / auto-merge) — set them in Settings"
  rm -f "$STATE/repo"
  cmd_labels
  # Branch protection: needs a public repo or a paid org plan. Without it, ship merges PRs directly (still works).
  if gh api -X PUT "repos/$slug/branches/$INTEG/protection" --input - >/dev/null 2>&1 <<JSON
{"required_status_checks":{"strict":false,"contexts":["lane-check"]},"enforce_admins":false,"required_pull_request_reviews":null,"restrictions":null}
JSON
  then echo "  ✓ $INTEG protected: PRs need the lane-check to pass (auto-merge on)"
  else echo "  – $INTEG not protected (plan doesn't allow it). PRs merge immediately; lane-check still runs and reports."; fi
  gh api -X PUT "repos/$slug/branches/$DEMO/protection" --input - >/dev/null 2>&1 <<JSON || true
{"required_status_checks":null,"enforce_admins":false,"required_pull_request_reviews":null,"restrictions":null,"allow_force_pushes":false,"allow_deletions":false}
JSON
  echo
  echo "✓ Repo ready: https://github.com/$slug   (default branch $INTEG, demo branch $DEMO)"
  echo "Next: invite teammates (gh api -X PUT repos/$slug/collaborators/<login>), then run /hack-wayfinder."
}

# promote [--yes]: fast-forward prod to dev and tag it. Humans decide; the git-guard hook makes agents ask.
cmd_promote() {
  has_remote || die "no origin remote"
  git fetch -q origin "$INTEG" "$DEMO" || die "fetch failed"
  local n; n="$(git rev-list --count "origin/$DEMO..origin/$INTEG")"
  [ "$n" -gt 0 ] || { echo "$DEMO is already at $INTEG."; return 0; }
  echo "Promoting $n commit(s) $INTEG → $DEMO:"; git log --format='  %h %s (%an)' "origin/$DEMO..origin/$INTEG" | head -30
  if [ "${1:-}" != "--yes" ]; then
    printf 'Did someone just run the golden path end-to-end on %s? Type "demo" to promote: ' "$INTEG"
    read -r ans; [ "$ans" = "demo" ] || die "not promoted."
  fi
  local tag; tag="demo-$(date +%m%d-%H%M)"
  HACK_PROMOTE=1 git push -q origin "origin/$INTEG:refs/heads/$DEMO" || die "push to $DEMO failed (not a fast-forward?)"
  git tag "$tag" "origin/$INTEG" && HACK_PROMOTE=1 git push -q origin "$tag"
  echo "✓ $DEMO updated. Tagged $tag — last known-good demo. To roll back the demo machine: git checkout <older demo-* tag>"
}

# ───────────────────────────── run ─────────────────────────────

# Finds the Xcode project/workspace and scheme. Sets IOS_TARGET (array) and IOS_SCHEME.
ios_target() {
  if [ -f project.yml ] && command -v xcodegen >/dev/null 2>&1; then xcodegen generate -q || die "xcodegen failed"; fi
  local ws proj
  ws="$(find . -maxdepth 2 -name '*.xcworkspace' -not -path '*/.build/*' -not -path '*.xcodeproj/*' | head -1)"
  proj="$(find . -maxdepth 2 -name '*.xcodeproj' -not -path '*/.build/*' | head -1)"
  if [ -n "$ws" ]; then IOS_TARGET=(-workspace "$ws"); elif [ -n "$proj" ]; then IOS_TARGET=(-project "$proj"); else die "no Xcode project found"; fi
  IOS_SCHEME="$(cfg '.run.scheme // empty')"
  [ -n "$IOS_SCHEME" ] || IOS_SCHEME="$(xcodebuild "${IOS_TARGET[@]}" -list -json 2>/dev/null | jq -r '(.workspace // .project).schemes[0] // empty')"
  [ -n "$IOS_SCHEME" ] || die "no scheme found — set .run.scheme in .hack/lanes.json"
}

# ───────────────────────────── iOS on a real phone ─────────────────────────────
# Signing is per person and never committed: the team id lives in .hack/local.json and is passed on the command line,
# so project.pbxproj is never touched. See stacks/ios/DEVICE.md.

local_set() { # <jq filter> [jq args…]
  local f="$1"; shift; local tmp; tmp="$(mktemp)"
  jq "$@" "$f" "$LOCAL" > "$tmp" && mv "$tmp" "$LOCAL"
}

# Apple ID teams known to Xcode on this Mac: TEAMID <tab> name <tab> free|paid
ios_teams() {
  plutil -extract IDEProvisioningTeams json -o - "$HOME/Library/Preferences/com.apple.dt.Xcode.plist" 2>/dev/null \
    | jq -r '[.[][]] | unique_by(.teamID)[] | [.teamID, (.teamName // "?"), (if .isFreeProvisioningTeam then "free" else "paid" end)] | @tsv' 2>/dev/null
}

ios_team() {
  local t; t="$(jq -r '.ios.team // empty' "$LOCAL" 2>/dev/null)"
  if [ -z "$t" ]; then
    local all; all="$(ios_teams)"
    if [ "$(printf '%s' "$all" | grep -c .)" = "1" ]; then t="$(printf '%s' "$all" | cut -f1)"; [ -f "$LOCAL" ] && local_set '.ios.team = $t' --arg t "$t"; fi
  fi
  [ -n "$t" ] && echo "$t"
}

# The physical iPhone to use: identifier <tab> udid <tab> name <tab> developerMode <tab> pairing <tab> transport
ios_phone() {
  mkdir -p "$STATE"; local j="$STATE/devices.json" want
  xcrun devicectl list devices --json-output "$j" >/dev/null 2>&1 || return 1
  want="$(jq -r '.ios.device // empty' "$LOCAL" 2>/dev/null)"
  jq -r --arg w "$want" '
    [.result.devices[] | select(.hardwareProperties.reality == "physical" and .hardwareProperties.platform == "iOS")
      | {id: .identifier, udid: .hardwareProperties.udid, name: (.deviceProperties.name // "iPhone"),
         dev: (.deviceProperties.developerModeStatus // "unknown"), pair: (.connectionProperties.pairingState // "unknown"),
         via: (.connectionProperties.transportType // "none")}]
    | (map(select($w != "" and (.name == $w or .udid == $w))) + (map(select(.via != "none")) | sort_by(.via != "wired")) + .)
    | .[0] // empty | [.id, .udid, .name, .dev, .pair, .via] | @tsv' "$j" 2>/dev/null
}

# device [--team ID] [--phone "name"]: the one-time checklist. Exit 0 only when a phone build can go ahead.
cmd_device() {
  [ "$(uname)" = "Darwin" ] && command -v xcodebuild >/dev/null 2>&1 || die "No Mac/Xcode here — a phone build needs a Mac."
  [ -f "$LOCAL" ] || die "run scripts/hack setup first"
  while [ $# -gt 0 ]; do
    case "$1" in
      --team) local_set '.ios.team = $t' --arg t "${2:-}"; shift ;;
      --phone) local_set '.ios.device = $t' --arg t "${2:-}"; shift ;;
    esac; shift
  done
  local ok=1 teams team row id udid name dev pair via
  echo "── iPhone checklist ──"
  echo "  ✓ $(xcodebuild -version 2>/dev/null | head -1)"
  teams="$(ios_teams)"; team="$(ios_team)"
  if [ -z "$teams" ] && [ -z "$team" ]; then
    echo "  ✗ No Apple ID in Xcode. Open Xcode > Settings > Accounts > + > Apple Account and sign in. A free Apple ID is enough."; ok=0
  elif [ -z "$team" ]; then
    echo "  ✗ More than one Apple team on this Mac. Pick one: scripts/hack device --team <ID>"; printf '%s\n' "$teams" | sed 's/^/      /'; ok=0
  else
    echo "  ✓ Signing team: $team $(printf '%s\n' "$teams" | awk -F'\t' -v t="$team" '$1 == t {print "(" $2 ", " $3 ")"}')"
  fi
  row="$(ios_phone)"
  if [ -z "$row" ]; then
    echo "  ✗ No iPhone found. Plug it in with the cable, unlock it, and tap Trust on the phone."; ok=0
  else
    IFS=$'\t' read -r id udid name dev pair via <<EOF2
$row
EOF2
    if [ "$via" = "none" ]; then echo "  ✗ '$name' is known but not connected. Plug it in with the cable and unlock it."; ok=0
    else echo "  ✓ iPhone: $name (connected: $via)"; fi
    if [ "$pair" = "paired" ]; then echo "  ✓ Paired with this Mac"
    else echo "  ✗ Not paired. Unlock the phone and tap Trust; if nothing appears, open Xcode > Window > Devices and Simulators."; ok=0; fi
    case "$dev" in
      enabled) echo "  ✓ Developer Mode is on" ;;
      disabled) echo "  ✗ Developer Mode is off. On the phone: Settings > Privacy & Security > Developer Mode > on, restart, then confirm."; ok=0 ;;
      *) echo "  ? Developer Mode: can't tell yet. If the build fails, check Settings > Privacy & Security > Developer Mode." ;;
    esac
  fi
  echo
  if [ "$ok" = 1 ]; then echo "✓ Ready. Put the app on the phone: scripts/hack run --device"; return 0; fi
  echo "Not ready yet. Fix the ✗ lines (stacks/ios/DEVICE.md has the details), then run this again."; return 1
}

ios_device_hints() { # <log file>
  local f="$1"
  grep -Eqi 'no account for team|no accounts? ' "$f" && echo "  → Xcode has no Apple ID for this team. Xcode > Settings > Accounts, sign in, then retry."
  grep -Eqi 'developer mode' "$f" && echo "  → Developer Mode is off on the phone: Settings > Privacy & Security > Developer Mode."
  grep -Eqi 'not been explicitly trusted|untrusted developer|invalid code signature' "$f" && echo "  → First install from this Apple ID: on the phone open Settings > General > VPN & Device Management, tap your Apple ID, tap Trust. Then run it again."
  grep -Eqi 'device (is|was) locked|passcode|unlock' "$f" && echo "  → The phone is locked. Unlock it and retry."
  grep -Eqi 'maximum number of app|app id.*(limit|maximum)|exceeded' "$f" && echo "  → A free Apple ID allows only a few new app IDs per week. Keep the same app name and bundle id; don't rename."
  grep -Eqi 'no profiles for|provisioning profile' "$f" && echo "  → No provisioning profile yet. Open the project in Xcode once with the phone plugged in, choose your team under Signing & Capabilities, build once, then close WITHOUT committing project.pbxproj (git restore it)."
  grep -Eqi 'unpaired|not paired|pairing' "$f" && echo "  → The phone is not paired with this Mac. Unlock it and tap Trust."
  return 0
}

# run --device [--prod]: build for the plugged-in iPhone, install, launch.
ios_device_run() {
  local prod=0; [ "${1:-}" = "--prod" ] && prod=1
  [ "$(uname)" = "Darwin" ] && command -v xcodebuild >/dev/null 2>&1 || die "No Mac/Xcode here — a phone build needs a Mac."
  mkdir -p "$STATE"
  local team row id udid name dev pair via base bid me dd app log="$STATE/device-build.log"
  team="$(ios_team)"; [ -n "$team" ] || die "no signing team yet — run: scripts/hack device"
  row="$(ios_phone)"; [ -n "$row" ] || die "no iPhone found — plug it in, unlock it, then: scripts/hack device"
  IFS=$'\t' read -r id udid name dev pair via <<EOF2
$row
EOF2
  [ "$via" != "none" ] || die "'$name' is not connected — plug it in with the cable and unlock it"
  [ "$dev" != "disabled" ] || die "Developer Mode is off on '$name' — Settings > Privacy & Security > Developer Mode"
  local cache="${HACK_BUILD_DIR:-$HOME/Library/Caches/hack-kit}/$(basename "$ROOT")-$(printf '%s' "$ROOT" | cksum | cut -d' ' -f1)"
  if [ "$prod" = 1 ]; then
    # Build exactly what was promoted, from a clean checkout, whatever state this working copy is in.
    git fetch -q origin "$DEMO" || die "could not fetch $DEMO"
    local wt="$cache/prod-src"
    git worktree remove --force "$wt" >/dev/null 2>&1 || true; rm -rf "$wt"
    git worktree add -q --detach "$wt" "origin/$DEMO" || die "could not check out $DEMO"
    cd "$wt" || exit 1
    echo "Building $DEMO ($(git log -1 --format='%h %s'))…"
  fi
  ios_target
  base="$(xcodebuild "${IOS_TARGET[@]}" -scheme "$IOS_SCHEME" -showBuildSettings -json 2>/dev/null | jq -r '.[0].buildSettings.PRODUCT_BUNDLE_IDENTIFIER // empty')"
  [ -n "$base" ] || die "could not read the app's bundle identifier"
  # Each Apple ID needs its own bundle id (free accounts can't share one), so add the person's username.
  me="$(my_login | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9-')"
  bid="$(jq -r '.ios.bundle // empty' "$LOCAL" 2>/dev/null)"; [ -n "$bid" ] || bid="$base${me:+.$me}"
  dd="$cache/dd-device"; mkdir -p "$dd"
  echo "Building '$IOS_SCHEME' for $name (team $team, bundle id $bid)…"
  if ! xcodebuild "${IOS_TARGET[@]}" -scheme "$IOS_SCHEME" -configuration Debug -destination "id=$udid" -derivedDataPath "$dd" \
        -allowProvisioningUpdates DEVELOPMENT_TEAM="$team" PRODUCT_BUNDLE_IDENTIFIER="$bid" CODE_SIGN_STYLE=Automatic -quiet build > "$log" 2>&1; then
    grep -E "error:|not allowed|failed with|BUILD FAILED" "$log" | sort -u | head -20
    ios_device_hints "$log"
    die "PHONE BUILD FAILED — full log: .hack/state/device-build.log"
  fi
  app="$(find "$dd/Build/Products/Debug-iphoneos" -maxdepth 1 -name '*.app' | head -1)"
  [ -n "$app" ] || die "built, but no .app found"
  if ! xcrun devicectl device install app --device "$id" "$app" > "$log" 2>&1; then
    tail -5 "$log"; ios_device_hints "$log"; die "INSTALL FAILED — full log: .hack/state/device-build.log"
  fi
  if ! xcrun devicectl device process launch --device "$id" --terminate-existing "$bid" > "$log" 2>&1; then
    tail -5 "$log"; ios_device_hints "$log"
    echo "✓ Installed on $name, but it didn't open. Unlock the phone and tap the app icon; if iOS refuses, follow the → line above."
    return 0
  fi
  echo "✓ Running $bid on $name.$( [ "$prod" = 1 ] && echo " This is the $DEMO build." )"
  echo "  Agents can't see a real phone: ask the user what is on screen."
}

# Pick (and boot) the simulator: configured name → a booted standard iPhone → first available iPhone. Prints its UDID.
ios_pick_sim() {
  local want udid; want="$(cfg '.run.simulator // empty')"
  udid="$(xcrun simctl list devices available -j | jq -r --arg w "$want" '
    [.devices | to_entries[] | select(.key | test("iOS")) | .value[]] as $all
    | (if $w != "" then ($all | map(select(.name == $w)) | sort_by(.state != "Booted") | .[0].udid) else null end)
      // ($all | map(select(.state == "Booted" and (.name | test("^iPhone [0-9]")))) | .[0].udid)
      // ($all | map(select(.name | test("^iPhone [0-9]"))) | .[0].udid)
      // ($all | map(select(.name | startswith("iPhone"))) | .[0].udid)
      // empty')"
  [ -n "$udid" ] || die "no iPhone simulator available — install one in Xcode > Settings > Components"
  xcrun simctl boot "$udid" 2>/dev/null || true
  echo "$udid"
}

# sim: boot the simulator `run` will use and print its UDID (so a live panel can attach before the build).
cmd_sim() {
  [ "$(uname)" = "Darwin" ] && command -v xcrun >/dev/null 2>&1 || die "No Mac/Xcode here — no simulator."
  ios_pick_sim
}

ios_run() {
  local panel=0; [ "${1:-}" = "--panel" ] && panel=1
  [ "$(uname)" = "Darwin" ] && command -v xcodebuild >/dev/null 2>&1 || {
    echo "No Mac/Xcode here — can't run the iOS app locally. Ship it and ask a Mac teammate: scripts/hack request <lane> \"please run + screenshot <what>\""; return 0; }
  local udid dd app bid scheme; local -a target
  ios_target; target=("${IOS_TARGET[@]}"); scheme="$IOS_SCHEME"
  udid="$(ios_pick_sim)" || exit 1
  # --panel: the app is shown in Claude's built-in simulator panel, so don't also open a Simulator window.
  [ "$panel" = 1 ] || open -a Simulator 2>/dev/null || true
  # Build OUTSIDE the repo: in an iCloud-synced folder (Desktop, Documents) the built .app picks up
  # extended attributes and code signing fails with "resource fork, Finder information, or similar detritus".
  dd="${HACK_BUILD_DIR:-$HOME/Library/Caches/hack-kit}/$(basename "$ROOT")-$(printf '%s' "$ROOT" | cksum | cut -d' ' -f1)/dd"
  mkdir -p "$dd"
  echo "Building scheme '$scheme'…"
  if ! xcodebuild "${target[@]}" -scheme "$scheme" -configuration Debug -destination "id=$udid" -derivedDataPath "$dd" -quiet build > "$STATE/build.log" 2>&1; then
    grep -E "error:|not allowed|failed with|BUILD FAILED" "$STATE/build.log" | sort -u | head -30
    die "BUILD FAILED — full log: .hack/state/build.log"
  fi
  app="$(find "$dd/Build/Products/Debug-iphonesimulator" -maxdepth 1 -name '*.app' | head -1)"
  [ -n "$app" ] || die "built, but no .app found"
  bid="$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$app/Info.plist")"
  xcrun simctl terminate "$udid" "$bid" >/dev/null 2>&1 || true
  xcrun simctl install "$udid" "$app" && xcrun simctl launch "$udid" "$bid" >/dev/null || die "install/launch failed"
  sleep 3
  xcrun simctl io "$udid" screenshot "$STATE/last-run.png" >/dev/null 2>&1 || true
  echo "✓ Running $bid on simulator $udid"
  echo "  app: $app"
  echo "  screenshot: .hack/state/last-run.png   (re-take: xcrun simctl io $udid screenshot <file>)"
}

# scaffold-ios <AppName>: a minimal SwiftUI app whose project file never changes when files are added.
cmd_scaffold_ios() {
  local name="${1:-}"
  echo "$name" | grep -Eq '^[A-Za-z][A-Za-z0-9]*$' || die "usage: scripts/hack scaffold-ios <AppName>   (letters/digits only)"
  [ -e "$name.xcodeproj" ] && die "$name.xcodeproj already exists"
  mkdir -p "$name.xcodeproj" "$name/App" "$name/Shared"
  sed "s/__APP__/$name/g; s/__BUNDLE__/$(echo "$name" | tr 'A-Z' 'a-z')/g" "$ROOT/stacks/ios/project.pbxproj.template" > "$name.xcodeproj/project.pbxproj"
  cat > "$name/App/${name}App.swift" <<SWIFT
import SwiftUI

// Lead lane owns this file: the only place that references every lane's entry view.
@main
struct ${name}App: App {
    var body: some Scene {
        WindowGroup {
            Text("$name")
                .font(.largeTitle.bold())
        }
    }
}
SWIFT
  echo "// Types every lane uses. Lead lane owns this folder; others request changes." > "$name/Shared/Shared.swift"
  echo "✓ Created $name.xcodeproj + $name/ (App/, Shared/). Add one folder per lane under $name/ and list them in .hack/lanes.json."
  echo "  Try it: scripts/hack run"
}

has_xcode_project() { [ -f project.yml ] || [ -n "$(find . -maxdepth 2 \( -name '*.xcodeproj' -o -name '*.xcworkspace' \) -not -path '*/.build/*' | head -1)" ]; }

# build: compile only (no simulator, no launch). The check `ship` runs before every merge on iOS.
cmd_build() {
  mkdir -p "$STATE"
  local c; c="$(cfg '.run.check // empty')"
  if [ -n "$c" ]; then echo "check: $c"; ( eval "$c" ); return $?; fi
  has_xcode_project || { echo "Nothing to build: no Xcode project, and no run.check set in .hack/lanes.json."; return 0; }
  [ "$(uname)" = "Darwin" ] && command -v xcodebuild >/dev/null 2>&1 || { echo "No Mac/Xcode here — build check skipped. A Mac teammate's next ship or run will catch a break."; return 0; }
  local dd; ios_target
  dd="${HACK_BUILD_DIR:-$HOME/Library/Caches/hack-kit}/$(basename "$ROOT")-$(printf '%s' "$ROOT" | cksum | cut -d' ' -f1)/dd"
  mkdir -p "$dd"; echo "Build check: scheme '$IOS_SCHEME'…"
  if ! xcodebuild "${IOS_TARGET[@]}" -scheme "$IOS_SCHEME" -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath "$dd" -quiet build > "$STATE/build.log" 2>&1; then
    grep -E "error:|not allowed|failed with|BUILD FAILED" "$STATE/build.log" | sort -u | head -30
    echo "BUILD FAILED — full log: .hack/state/build.log"; return 1
  fi
  echo "✓ Builds."
}

# doctor: is the kit itself healthy on this machine? Repairs what is safe to repair, and says how to fix the rest.
cmd_doctor() {
  local bad=0 lane br
  ok()  { echo "  ✓ $1"; }
  no()  { echo "  ✗ $1"; echo "      fix: $2"; bad=1; }
  echo "── Kit check ──"
  local t; for t in git gh jq; do command -v "$t" >/dev/null 2>&1 && ok "$t" || no "$t is not installed" "brew install $t"; done
  bash -n "$ROOT/scripts/hack" 2>/dev/null && ok "scripts/hack parses" || no "scripts/hack has a syntax error (every hook is off)" "git checkout origin/$DEMO -- scripts/hack   (last promoted copy), then tell the lead lane"
  jq empty "$CFG" 2>/dev/null && ok ".hack/lanes.json is valid" || no ".hack/lanes.json is not valid JSON (lane guard is off)" "git checkout origin/$INTEG -- .hack/lanes.json, or ask the lead lane"
  jq empty "$ROOT/.claude/settings.json" 2>/dev/null && ok ".claude/settings.json is valid" || no ".claude/settings.json is not valid JSON (no hooks run)" "git checkout origin/$INTEG -- .claude/settings.json, or ask the lead lane"
  if gh auth status >/dev/null 2>&1; then ok "GitHub login"; else no "gh is not logged in (no inbox, no ship)" "gh auth login"; fi
  lane="$(my_lane)"
  if [ -n "$lane" ] && lane_exists "$lane"; then ok "lane: $lane"; else no "this checkout has no lane (guard, sync and inbox are off)" "scripts/hack setup"; fi
  br="$(current_branch)"
  if [ -n "$lane" ]; then [ "$br" = "lane/$lane" ] && ok "branch: $br" || no "on '${br:-detached HEAD}', expected lane/$lane" "scripts/hack setup $lane"; fi
  if [ "$(git config core.hooksPath)" = ".githooks" ]; then ok "git hooks active"; else git config core.hooksPath .githooks && ok "git hooks were off — switched back on"; fi
  chmod +x "$ROOT/scripts/hack" "$ROOT"/.githooks/* 2>/dev/null || true
  if in_git_op; then no "a merge is in progress (sync and ship are paused)" "finish it with the user: keep the OWNING lane's version of each conflicted file, then git commit"; else ok "no merge in progress"; fi
  if has_remote; then
    if git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=6 ls-remote -q --exit-code origin "refs/heads/$INTEG" >/dev/null 2>&1; then ok "GitHub reachable"
    else no "can't reach GitHub (you can keep building; sync, inbox and ship wait)" "check the network, then scripts/hack sync"; fi
  else no "no origin remote" "the lead runs scripts/hack init <org/repo>"; fi
  rm -f "$STATE/sync.ts" "$STATE/inbox.ts" "$STATE/queue.ts" 2>/dev/null || true
  [ "$bad" = 0 ] && echo "Kit is healthy." || echo "Fix the ✗ lines above. Building inside your lane is always safe meanwhile."
  return $bad
}

cmd_run() {
  mkdir -p "$STATE"
  case " $* " in *" --device "*) case " $* " in *" --prod "*) ios_device_run --prod ;; *) ios_device_run ;; esac; return $? ;; esac
  local c; c="$(cfg '.run.command // empty')"
  if [ -n "$c" ]; then
    echo "run: $c"; eval "$c"; local rc=$?
    local u; u="$(cfg '.run.url // empty')"; [ -n "$u" ] && [ "$rc" = 0 ] && echo "open: $u"
    return $rc
  fi
  if [ -f project.yml ] || [ -n "$(find . -maxdepth 2 \( -name '*.xcodeproj' -o -name '*.xcworkspace' \) -not -path '*/.build/*' | head -1)" ]; then ios_run "$@"; return $?; fi
  if [ -f package.json ] && jq -e '.scripts.dev' package.json >/dev/null 2>&1; then
    [ -d node_modules ] || npm install
    echo "run: npm run dev   (agents: start this in the background)"; npm run dev; return $?
  fi
  die "no app found yet. Set .run.command in .hack/lanes.json, or add an Xcode project / a package.json with a dev script."
}

# ───────────────────────────── dispatch ─────────────────────────────

usage() {
  cat <<EOF
hack — hackathon kit
  setup [lane]            set up YOUR workspace after cloning (branch, hooks, identity)
  run [--panel]           build + launch the app (one command; --panel = shown in Claude's simulator panel)
  run --device [--prod]   iOS: build, install and launch on the plugged-in iPhone (--prod = the promoted demo build)
  device                  iOS: the one-time phone checklist (Apple ID, cable, trust, Developer Mode)
  stack [ios|other]       LEAD: which kind of app this is (picks the guide in stacks/)
  build                   compile only: the check `ship` runs before every merge (iOS build, or run.check)
  doctor                  check the kit itself on this machine, repair what is safe, say how to fix the rest
  sim                     boot the simulator `run` uses and print its id
  decide "title" "Before/Now/Why" [--affects a,b]   record a direction change + push it to every agent
  direction [n]           the latest decisions
  feedback "title" ["details"]   log a problem/improvement for the KIT itself (filed on the kit repo)
  ship "msg" [--closes N] commit → sync → PR into $INTEG → auto-merge
  sync                    pull teammates' merged work into your lane branch
  inbox [--all]           new issue activity for your lane
  request <lane> "title" ["details"]   ask another lane for something (GitHub issue)
  pulse                   heartbeat check: what changed since the last look, or "PULSE: quiet" (see /hack-heartbeat)
  queue                   your lane's tickets: ready for a worker / in progress / needs you
  collect <worker-branch> merge a finished background worker's branch into your lane branch
  orchestrate on|off      keep this chat dispatching workers while ready tickets remain
  status                  who owns what, how far ahead/behind you are
  promote                 $INTEG → $DEMO (demo-ready) + tag
  lane-check --staged | --range A...B | <files>   verify changes stay in lane
  team [n]                LEAD, before lanes are named: set the team size (2–6 people = 2–6 lanes)
  init <org/repo>         LEAD, once: create the repo, branches, labels
  labels                  LEAD: (re)create lane labels after lanes are named
  scaffold-ios <AppName>  LEAD: minimal SwiftUI app with a conflict-proof Xcode project
EOF
}

sub="${1:-}"; [ $# -gt 0 ] && shift
case "$sub" in
  setup) cmd_setup "$@" ;;
  run) cmd_run "$@" ;;
  sim) cmd_sim ;;
  feedback) cmd_feedback "$@" ;;
  decide) cmd_decide "$@" ;;
  direction) cmd_direction "$@" ;;
  ship) cmd_ship "$@" ;;
  sync) rm -f "$STATE/sync.ts"; cmd_sync && echo "(up to date with $INTEG)" ;;
  inbox) cmd_inbox "$@" ;;
  request) cmd_request "$@" ;;
  status) cmd_status ;;
  promote) cmd_promote "$@" ;;
  lane-check) cmd_lane_check "$@" ;;
  init) cmd_init "$@" ;;
  team) cmd_team "$@" ;;
  stack) cmd_stack "$@" ;;
  device) cmd_device "$@" ;;
  labels) cmd_labels ;;
  scaffold-ios) cmd_scaffold_ios "$@" ;;
  queue) cmd_queue ;;
  build) cmd_build ;;
  doctor) cmd_doctor ;;
  pulse) cmd_pulse "$@" ;;
  orchestrate) cmd_orchestrate "$@" ;;
  collect) cmd_collect "$@" ;;
  hook) cmd_hook "$@" ;;
  whoami) echo "lane=$(my_lane) login=$(my_login) branch=$(current_branch)" ;;
  ""|help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
